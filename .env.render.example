# Contoh environment variable untuk Render.
# Jangan disalin ke .env lokal. Di Render, variabel ini diisi lewat Dashboard
# atau otomatis oleh render.yaml.

APP_NAME=KolabKreatif
APP_ENV=production
APP_KEY=base64:AMBIL_DARI_PHP_ARTISAN_KEY_GENERATE_SHOW
APP_DEBUG=false
APP_URL=https://kolabkreatif.onrender.com

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=info

# Salin "Internal Database URL" dari Render Postgres.
DB_CONNECTION=pgsql
DATABASE_URL=postgresql://user:password@dpg-xxxxxx-a.singapore-postgres.render.com/kolabkreatif

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@kolabkreatif.onrender.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
